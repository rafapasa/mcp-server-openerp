# ================================================================
# Stage base
# ================================================================
FROM golang:1.25.5-alpine AS base
WORKDIR /app
RUN apk add --no-cache git
COPY go.mod go.sum ./
RUN go mod download
COPY . .

# ================================================================
# Target: server (api + webhook + mcp em um binário só)
# ================================================================
FROM base AS server-builder
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -o /bin/server ./cmd/server

FROM oraclelinux:9-slim AS server
WORKDIR /app
COPY --from=server-builder /bin/server /app/server
EXPOSE 8080
CMD ["/app/server"]

# ================================================================
# Target: stdio (só pra distribuir, não roda na OCI)
# ================================================================
FROM base AS stdio-builder
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -o /bin/stdio ./cmd/stdio

FROM oraclelinux:9-slim AS stdio
WORKDIR /app
COPY --from=stdio-builder /bin/stdio /app/stdio
CMD ["/app/stdio"]