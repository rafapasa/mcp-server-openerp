# ============================================
# STAGE 1: Builder Base (compartilhado)
# ============================================
FROM golang:1.25.5-alpine AS builder-base

WORKDIR /app

RUN apk add --no-cache git ca-certificates

COPY go.mod go.sum ./
RUN go mod download && go mod verify

COPY . .

# ============================================
# STAGE 2: Build Webhook
# ============================================
FROM builder-base AS builder-webhook

WORKDIR /app

RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -extldflags -static" \
    -trimpath \
    -o /webhook \
    ./cmd/webhook/main.go

# ============================================
# STAGE 3: Build API
# ============================================
FROM builder-base AS builder-api

WORKDIR /app

RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -extldflags -static" \
    -trimpath \
    -o /api \
    ./cmd/api/main.go

# ============================================
# STAGE 4: Build MCP (stdio)
# ============================================
FROM builder-base AS builder-mcp

WORKDIR /app

RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -extldflags -static" \
    -trimpath \
    -o /mcp \
    ./cmd/stdio/main.go

# ============================================
# STAGE 5: Imagem Final Webhook
# ============================================
FROM alpine:3.20 AS webhook

RUN apk --no-cache add ca-certificates tzdata curl

WORKDIR /app

COPY --from=builder-webhook /webhook .

RUN adduser -D -u 1000 appuser && chown appuser:appuser /app
USER appuser

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["./webhook"]

# ============================================
# STAGE 6: Imagem Final API
# ============================================
FROM alpine:3.20 AS api

RUN apk --no-cache add ca-certificates tzdata curl

WORKDIR /app

COPY --from=builder-api /api .

RUN adduser -D -u 1000 appuser && chown appuser:appuser /app
USER appuser

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8081/health || exit 1

ENTRYPOINT ["./api"]

# ============================================
# STAGE 7: Imagem Final MCP
# ============================================
FROM alpine:3.20 AS mcp

RUN apk --no-cache add ca-certificates

WORKDIR /app
COPY --from=builder-mcp /mcp .

RUN adduser -D -u 1000 appuser && chown appuser:appuser /app
USER appuser

ENTRYPOINT ["./mcp"]